{
	"name": "svedit-workspace",
	"private": true,
	"version": "0.16.0",
	"packageManager": "pnpm@12.8.1",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "pnpm dev:site",
		"dev:site": "node scripts/dev_site.mjs",
		"dev:svelte": "pnpm --filter svedit dev",
		"dev:react": "pnpm --filter @svedit/react dev",
		"dev:vue": "pnpm --filter @svedit/vue dev",
		"dev:solid": "pnpm --filter @svedit/solid dev",
		"build": "pnpm -r build",
		"build:lib": "pnpm -r --filter @svedit/core --filter svedit --filter @svedit/react --filter @svedit/vue --filter @svedit/solid build:lib",
		"build:site": "node scripts/build_site.mjs",
		"publish:all": "pnpm -r publish --access public",
		"check": "pnpm -r check",
		"lint": "pnpm -r lint && pnpm lint:styles",
		"lint:styles": "node scripts/check_style_drift.mjs",
		"format": "pnpm -r format",
		"test": "pnpm -r --workspace-concurrency 1 test",
		"preview": "pnpm preview:site",
		"preview:site": "node scripts/serve_site.mjs",
		"perftest": "node scripts/perftest.mjs"
	},
	"engines": {
		"node": ">=20.19"
	},
	"devDependencies": {
		"playwright": "^1.64.0"
	}
}
