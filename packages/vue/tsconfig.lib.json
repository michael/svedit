{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"rootDir": "./src/lib",
		"outDir": "./dist",
		"paths": {
			"@svedit/vue": ["./src/lib/index.ts"]
		}
	},
	"include": ["src/lib/**/*.ts", "src/lib/**/*.vue"],
	"exclude": ["src/lib/**/*.test.*", "src/lib/**/*.spec.*"]
}
